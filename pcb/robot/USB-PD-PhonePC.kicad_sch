	(text "Pull ups based on single slave device\nand reducing power consumption."
		(exclude_from_sim no)
		(at 346.71 156.21 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0ac524a9-73af-4db4-bd30-5a16be2ab021")
	)
	(text "Looks like VIN_5V pulls up to 16 mA\nto program the MTP whereas all other\npower comes from SYS or VBUS with VBUS\ntaking precedence"
		(exclude_from_sim no)
		(at 288.29 160.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "5446565f-b48f-4b96-ac33-8380e5c57705")
	)
	(text "This should be kept low\nelse back currents can occur\nOnly test Forced PWM or Ultrasonic\nif you ensure no source present on\nVOUT"
		(exclude_from_sim no)
		(at 370.84 138.43 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify right bottom)
		)
		(uuid "8941d3d8-c350-46d4-b8f9-f278c6e9638f")
	)
	(text "Move both jumpers to toggle between\ndirectly connecting USB port D+/-\nwith MCU vs gated. \n"
		(exclude_from_sim no)
		(at 440.69 215.9 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "99979e42-248b-46f4-939f-0f0d28ae0f9f")
	)
	(text "NOTE: Only ONE of R3 (CC1) / R4 (CC2) should be populated for a direct \nmale USB-C plug configuration. Default: R3 populated, R4 DNP. \nThe unused CC-position contact must remain floating - do NOT tie it \nto 5V, GND, Rp, Rd, or the other CC line."
		(exclude_from_sim no)
		(at 173.99 143.764 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "d2b5d317-501f-4c46-8ac6-c069468da5f5")
	)
	(text "Enable takes 500 us or so. \nFor FRS you need to be less than 150\nSo GPIO0 needs to be on prior to the\nFRS request is sent. "
		(exclude_from_sim no)
		(at 425.45 134.62 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f9640cd2-3718-4cca-b848-2e1787601f9c")
	)
