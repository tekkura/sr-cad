	(text "For unidirectional downtranslation \nusing buffer with overvoltage-tolerant inputs\nThis can tolerate up to 7V, but will\nclamp at VCC (3V3) on the outputs."
		(exclude_from_sim no)
		(at 193.04 127 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "309f9928-5d3e-458e-b6c5-78c52055f563")
	)
	(text "This must be held at VIO during startup\nto prevent floating pins from\ndisrupting startup routine"
		(exclude_from_sim no)
		(at 146.05 144.78 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3df55b8e-7f76-48a9-800a-f4ac0b32db52")
	)
	(text "Bulk capacitance must \nbe close to Pin 4"
		(exclude_from_sim no)
		(at 141.732 52.832 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "40075a4a-34e2-4995-8b56-5ca73452d2e0")
	)
	(text "C74/C86/C89/C90 (100µF bulk, VCC-GND) removed - \nstress testing showed <100mV rail variation without them \n(see issue #4 discussion). Remaining decoupling sufficient."
		(exclude_from_sim no)
		(at 145.034 89.408 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "40af2d35-4e27-4fa1-8326-e0d5e6481e13")
	)
	(text "I2C V_high is 0.5*Vcc\nmeaning we need to use \nat least 2.5V (Assuming Vcc=5V)\n(3V3)\n"
		(exclude_from_sim no)
		(at 71.12 27.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "507630c9-f888-4b72-b6e9-056c97d6da1a")
	)
	(text "JST Connector to match Adafruit 4640 micromotor\nPolarity reversed on both motor outputs and encoders\nto compensate for opposing orientation without\nthe need to compensate in the firmware"
		(exclude_from_sim no)
		(at 217.932 33.528 0)
		(effects
